rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. WALLPAPERS CATALOG
    // Users can only read active wallpapers. Modifying the catalog is strictly Admin/Backend only.
    match /wallpapers/{wallpaperId} {
      allow read: if resource.data.isActive == true;
      allow write: if false; 
    }

    // 2. USER PROFILES & ENTITLEMENTS
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create their initial profile, but cannot spawn with active subscriptions
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.subscriptionStatus == 'NONE';
      
      // STRICT UPDATE RULES: Prevent Privilege Escalation
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    && validateUserUpdate();
    }
    
    // Helper function to lock down sensitive entitlement fields
    function validateUserUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      
      // 1. Users can NEVER modify their own subscription status or expiry
      let noSubscriptionTampering = !affectedKeys.hasAny(['subscriptionStatus', 'subscriptionExpiry', 'isAdmin']);
      
      // 2. Users can DELETE their retainedPremiumWallpaper (when switching to free after expiry), 
      // but they can NEVER create or modify it to forge a premium entitlement.
      let validRetainedTampering = !affectedKeys.hasAny(['retainedPremiumWallpaper']) 
                                   || !('retainedPremiumWallpaper' in request.resource.data);

      return noSubscriptionTampering && validRetainedTampering;
    }
  }
}
